# ---------------------------------------------------------------------------
# Idea Gauntlet — backend environment (public / self-host)
# Copy to .env and fill in. All values shown are safe local-dev defaults.
# ---------------------------------------------------------------------------

# Deployment mode: "self_host" (default) or "hosted".
# Self-host runs fully open with BYO keys. "hosted" is used only by the private
# overlay deployment and additionally requires the variables in the HOSTED block.
DEPLOYMENT_MODE=self_host

# Non-secret tuning (display name, gameplay) is in app/config.toml.

# --- LLM provider keys (backend-only; never sent to the frontend) ---
# Provide at least one, or enter keys in the in-app Settings modal.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Local Ollama (optional). Auto-detected at http://localhost:11434 if unset.
OLLAMA_BASE_URL=

# Which provider/model every critic (plus scoring, summaries, the
# gatekeeper) uses. Optional — falls back to whatever's set in the in-app
# Settings modal, then to a local-safe default. Set both when
# LOCK_LLM_SETTINGS=true, since Settings won't be available to configure it.
NON_AGENT_PROVIDER=
NON_AGENT_MODEL=

# Hides the API key / model fields in the in-app Settings modal (only BGM
# music remains user-editable there). Use this for a deploy where the LLM is
# fully configured via the env vars above and shouldn't be player-editable.
LOCK_LLM_SETTINGS=

# --- Database ---
# SQLite by default. For production use Postgres, e.g.:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/idea_gauntlet
DATABASE_URL=
# Where SQLite + Chroma data live when DATABASE_URL is unset.
BACKEND_DATA_DIR=
LANGMEM_CHROMA_PATH=

# --- HTTP / CORS ---
# Comma-separated allowed origins for the browser frontend.
# Leave blank for local dev (defaults to the Vite dev servers).
#   ALLOWED_ORIGINS=https://idea-gauntlet.com,https://www.idea-gauntlet.com
ALLOWED_ORIGINS=

# --- Auth ---
# Required (non-default) when DEPLOYMENT_MODE=hosted or ALLOWED_USER_EMAIL is set.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Single-email allowlist for a private self-host deployment (optional).
ALLOWED_USER_EMAIL=

# ---------------------------------------------------------------------------
# HOSTED block — consumed only by the private overlay (idea-gauntlet-hosted).
# Listed here for reference; not used by the public self-host build.
# ---------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# MONTHLY_SPEND_CAP_USD=
